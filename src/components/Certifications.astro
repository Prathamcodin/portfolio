---
import { certifications } from '../data/site';
---
<section id="credentials" class="reveal">
  <div class="eyebrow">Credentials</div>
  <h2 class="section-title">Certifications</h2>

  <div class="certs">
    {certifications.map((c) => (
      <article class="cert-card">
        <div class="cert-top">
          <div class="cert-tag">{c.tag}</div>
          <div class="cert-score">
            <svg class="cert-ring" viewBox="0 0 44 44" aria-hidden="true">
              <circle cx="22" cy="22" r="18" stroke="var(--border)" stroke-width="4" fill="none" />
              <circle
                cx="22" cy="22" r="18"
                stroke="url(#g)"
                stroke-width="4" fill="none"
                stroke-linecap="round"
                stroke-dasharray={`${(c.score / c.scoreMax) * 113.1} 113.1`}
                transform="rotate(-90 22 22)"
              />
              <defs>
                <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#a3e635"/>
                  <stop offset="1" stop-color="#22d3ee"/>
                </linearGradient>
              </defs>
            </svg>
            <div class="cert-score-num">{c.score}</div>
          </div>
        </div>
        <h3 class="cert-title">{c.title}</h3>
        <div class="cert-meta">
          <span>{c.issuer}</span>
          <span class="dot">·</span>
          <span>{c.period}</span>
        </div>
        <div class="cert-meta small">
          <span>{c.duration}</span>
          <span class="dot">·</span>
          <span>{c.credits} credits</span>
          <span class="dot">·</span>
          <span>Rank #{c.rank.toLocaleString()}</span>
        </div>
        <div class="cert-break">
          <div class="chip"><span class="k">Assignments</span><span class="v">{c.breakdown.assignment}</span></div>
          <div class="chip"><span class="k">Exam</span><span class="v">{c.breakdown.exam}</span></div>
        </div>
        <div class="cert-verify">
          <span class="mono dim">ID</span>
          <code>{c.verifyId}</code>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 900px) { .certs { grid-template-columns: 1fr; } }

  .cert-card {
    padding: 22px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
    position: relative;
    overflow: hidden;
  }
  .cert-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    background: var(--panel-hover);
  }

  .cert-top { display: flex; justify-content: space-between; align-items: center; }
  .cert-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
  }
  .cert-score { position: relative; width: 44px; height: 44px; }
  .cert-ring { width: 44px; height: 44px; }
  .cert-score-num {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    font-family: var(--font-mono);
    font-size: 13px; font-weight: 700;
    color: var(--fg);
  }

  .cert-title {
    font-size: 17px;
    margin: 4px 0 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .cert-meta {
    display: flex; flex-wrap: wrap; gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    align-items: center;
  }
  .cert-meta.small { color: var(--fg-dim); font-size: 11px; }
  .cert-meta .dot { color: var(--fg-dim); }

  .cert-break { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .cert-break .chip {
    display: flex; flex-direction: column;
    padding: 8px 12px;
    background: var(--panel-hover);
    border: 1px solid var(--border);
    border-radius: 8px;
    min-width: 96px;
  }
  .cert-break .chip .k {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cert-break .chip .v {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    margin-top: 2px;
  }

  .cert-verify {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
    display: flex; gap: 8px; align-items: center;
    font-size: 11px;
  }
  .cert-verify code {
    font-family: var(--font-mono);
    color: var(--fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
