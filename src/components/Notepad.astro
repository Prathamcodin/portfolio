---
---
<section id="notepad" class="reveal">
  <div class="eyebrow">Say hi</div>
  <h2 class="section-title">Doodle & Notes</h2>
  <p class="dim" style="margin: -10px 0 22px; max-width: 620px;">
    A little sandbox — leave a sketch or a note. Saved locally on your device, not sent anywhere. Download it if you want to share.
  </p>

  <div class="pad">
    <div class="pad-tabs" role="tablist">
      <button type="button" class="tab active" data-tab="draw" role="tab" aria-selected="true">✎ Sketch</button>
      <button type="button" class="tab" data-tab="note" role="tab" aria-selected="false">☰ Notes</button>
    </div>

    <div class="pad-body">
      <!-- Sketch tab -->
      <div class="pane" data-pane="draw">
        <div class="pad-toolbar">
          <div class="colors" role="radiogroup" aria-label="Pen color">
            <button type="button" class="swatch active" data-color="#a3e635" style="--c:#a3e635" aria-label="Lime"></button>
            <button type="button" class="swatch" data-color="#22d3ee" style="--c:#22d3ee" aria-label="Cyan"></button>
            <button type="button" class="swatch" data-color="#f59e0b" style="--c:#f59e0b" aria-label="Amber"></button>
            <button type="button" class="swatch" data-color="#ef4444" style="--c:#ef4444" aria-label="Red"></button>
            <button type="button" class="swatch" data-color="#ededf0" style="--c:#ededf0" aria-label="White"></button>
          </div>
          <div class="sizes">
            <label class="mono dim" style="font-size:11px;">Size</label>
            <input id="pen-size" type="range" min="1" max="18" value="3" />
          </div>
          <div class="tool-buttons">
            <button type="button" class="tool-btn" data-tool="pen" aria-pressed="true">Pen</button>
            <button type="button" class="tool-btn" data-tool="eraser" aria-pressed="false">Eraser</button>
            <button type="button" class="tool-btn" id="undo">Undo</button>
            <button type="button" class="tool-btn danger" id="clear">Clear</button>
            <button type="button" class="tool-btn primary" id="download">Download</button>
          </div>
        </div>

        <div class="canvas-wrap" id="canvas-wrap">
          <canvas id="pad" aria-label="Drawing canvas"></canvas>
          <div class="ruled"></div>
        </div>
      </div>

      <!-- Notes tab -->
      <div class="pane" data-pane="note" hidden>
        <textarea
          id="notes"
          class="notes"
          placeholder="Write anything — thoughts, feedback, a quick note to yourself. Autosaves as you type."
          spellcheck="false"
        ></textarea>
        <div class="notes-meta">
          <span class="mono dim" id="notes-count">0 chars</span>
          <button type="button" class="tool-btn danger" id="notes-clear">Clear</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pad {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .pad-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 10px 0;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }
  .tab {
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    border-radius: 8px 8px 0 0;
    border: 1px solid transparent;
    border-bottom: none;
    background: transparent;
    cursor: pointer;
    transition: color .15s ease, background .15s ease;
  }
  .tab:hover { color: var(--fg); }
  .tab.active {
    color: var(--accent);
    background: var(--bg-1);
    border-color: var(--border);
    border-bottom: 1px solid var(--bg-1);
    margin-bottom: -1px;
  }

  .pad-body { padding: 14px; }

  .pad-toolbar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 10px 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 12px;
  }
  .colors { display: flex; gap: 6px; }
  .swatch {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--c);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform .15s ease, border-color .15s ease;
  }
  .swatch:hover { transform: scale(1.1); }
  .swatch.active { border-color: var(--fg); box-shadow: 0 0 0 2px var(--border-strong); }

  .sizes { display: flex; align-items: center; gap: 8px; }
  .sizes input[type="range"] { accent-color: var(--accent); width: 100px; }

  .tool-buttons { display: flex; gap: 6px; margin-left: auto; flex-wrap: wrap; }
  .tool-btn {
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition: color .15s ease, border-color .15s ease, background .15s ease;
  }
  .tool-btn:hover { color: var(--fg); border-color: var(--border-strong); }
  .tool-btn[aria-pressed="true"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .tool-btn.primary { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
  .tool-btn.primary:hover { background: color-mix(in srgb, var(--accent) 85%, white); }
  .tool-btn.danger:hover { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 50%, transparent); }

  .canvas-wrap {
    position: relative;
    height: 380px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-2);
    overflow: hidden;
    cursor: crosshair;
  }
  .canvas-wrap.eraser { cursor: cell; }
  .ruled {
    position: absolute; inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to bottom, var(--border) 1px, transparent 1px),
      linear-gradient(to right, var(--border) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: 0 0;
    opacity: .8;
  }
  #pad { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

  .notes {
    width: 100%;
    min-height: 380px;
    padding: 18px;
    background: var(--bg-2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    resize: vertical;
    outline: none;
    background-image:
      linear-gradient(to bottom, transparent 27px, var(--border) 28px);
    background-size: 100% 28px;
    background-attachment: local;
  }
  .notes:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  .notes-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
</style>

<script>
  // --- Tab switching ---
  const tabs = document.querySelectorAll('.pad .tab');
  const panes = document.querySelectorAll('.pad .pane');
  tabs.forEach(t => t.addEventListener('click', () => {
    tabs.forEach(x => { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
    t.classList.add('active');
    t.setAttribute('aria-selected', 'true');
    const kind = t.getAttribute('data-tab');
    panes.forEach(p => {
      const match = p.getAttribute('data-pane') === kind;
      if (match) p.removeAttribute('hidden'); else p.setAttribute('hidden', '');
    });
    if (kind === 'draw') setTimeout(fitCanvas, 0);
  }));

  // --- Notes ---
  const notes = document.getElementById('notes');
  const notesCount = document.getElementById('notes-count');
  const notesClear = document.getElementById('notes-clear');
  const NOTES_KEY = 'pg_portfolio_notes';
  if (notes) {
    notes.value = localStorage.getItem(NOTES_KEY) || '';
    if (notesCount) notesCount.textContent = `${notes.value.length} chars`;
    notes.addEventListener('input', () => {
      localStorage.setItem(NOTES_KEY, notes.value);
      if (notesCount) notesCount.textContent = `${notes.value.length} chars`;
    });
  }
  if (notesClear && notes) notesClear.addEventListener('click', () => {
    if (!confirm('Clear all notes?')) return;
    notes.value = '';
    localStorage.removeItem(NOTES_KEY);
    if (notesCount) notesCount.textContent = '0 chars';
  });

  // --- Drawing canvas ---
  const canvas = document.getElementById('pad');
  const wrap = document.getElementById('canvas-wrap');
  const DRAW_KEY = 'pg_portfolio_sketch';
  const ctx = canvas?.getContext('2d');
  let dpr = window.devicePixelRatio || 1;
  let drawing = false;
  let color = '#a3e635';
  let size = 3;
  let tool = 'pen';
  let last = null;
  const history = [];

  function fitCanvas() {
    if (!canvas || !ctx) return;
    const rect = wrap.getBoundingClientRect();
    const prev = canvas.toDataURL();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    const img = new Image();
    img.onload = () => ctx.drawImage(img, 0, 0, rect.width, rect.height);
    img.src = prev;
  }

  function loadSaved() {
    if (!canvas || !ctx) return;
    const data = localStorage.getItem(DRAW_KEY);
    if (!data) return;
    const img = new Image();
    img.onload = () => {
      const rect = wrap.getBoundingClientRect();
      ctx.drawImage(img, 0, 0, rect.width, rect.height);
    };
    img.src = data;
  }

  function save() {
    if (!canvas) return;
    try { localStorage.setItem(DRAW_KEY, canvas.toDataURL('image/png')); } catch {}
  }

  function pushHistory() {
    if (!canvas) return;
    try {
      history.push(canvas.toDataURL('image/png'));
      if (history.length > 30) history.shift();
    } catch {}
  }

  function pos(e) {
    const rect = canvas.getBoundingClientRect();
    const t = e.touches ? e.touches[0] : e;
    return { x: t.clientX - rect.left, y: t.clientY - rect.top };
  }

  function start(e) {
    if (!ctx) return;
    pushHistory();
    drawing = true;
    last = pos(e);
    e.preventDefault();
  }
  function move(e) {
    if (!drawing || !ctx) return;
    const p = pos(e);
    ctx.globalCompositeOperation = tool === 'eraser' ? 'destination-out' : 'source-over';
    ctx.strokeStyle = color;
    ctx.lineWidth = tool === 'eraser' ? size * 4 : size;
    ctx.beginPath();
    ctx.moveTo(last.x, last.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    last = p;
    e.preventDefault();
  }
  function end() {
    if (!drawing) return;
    drawing = false;
    save();
  }

  if (canvas && wrap) {
    fitCanvas();
    loadSaved();
    window.addEventListener('resize', fitCanvas);

    canvas.addEventListener('pointerdown', start);
    canvas.addEventListener('pointermove', move);
    window.addEventListener('pointerup', end);
    canvas.addEventListener('pointerleave', end);

    // Swatches
    document.querySelectorAll('.swatch').forEach(sw => {
      sw.addEventListener('click', () => {
        document.querySelectorAll('.swatch').forEach(x => x.classList.remove('active'));
        sw.classList.add('active');
        color = sw.getAttribute('data-color') || '#a3e635';
        if (tool === 'eraser') selectTool('pen');
      });
    });

    // Size
    const sizeEl = document.getElementById('pen-size');
    if (sizeEl) sizeEl.addEventListener('input', () => { size = Number(sizeEl.value); });

    // Tool buttons
    const toolBtns = document.querySelectorAll('.tool-btn[data-tool]');
    function selectTool(t) {
      tool = t;
      toolBtns.forEach(b => b.setAttribute('aria-pressed', b.getAttribute('data-tool') === t ? 'true' : 'false'));
      wrap.classList.toggle('eraser', t === 'eraser');
    }
    toolBtns.forEach(b => b.addEventListener('click', () => selectTool(b.getAttribute('data-tool'))));

    // Undo
    document.getElementById('undo')?.addEventListener('click', () => {
      const last = history.pop();
      if (!last) return;
      const img = new Image();
      img.onload = () => {
        const rect = wrap.getBoundingClientRect();
        ctx.globalCompositeOperation = 'source-over';
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, rect.width, rect.height);
        save();
      };
      img.src = last;
    });

    // Clear
    document.getElementById('clear')?.addEventListener('click', () => {
      if (!confirm('Clear the sketch?')) return;
      pushHistory();
      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      save();
    });

    // Download
    document.getElementById('download')?.addEventListener('click', () => {
      const url = canvas.toDataURL('image/png');
      const a = document.createElement('a');
      a.download = `sketch-${new Date().toISOString().slice(0,10)}.png`;
      a.href = url;
      a.click();
    });
  }
</script>
