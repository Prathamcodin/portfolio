---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---
<header class="page-head">
  <div class="eyebrow">{eyebrow}</div>
  <h1 class="page-title">{title}</h1>
  {subtitle && <p class="page-sub">{subtitle}</p>}
</header>

<style>
  .page-head { margin-bottom: 48px; }
  .page-title {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 8px 0 12px;
    font-weight: 700;
    background: linear-gradient(180deg, #f4f4f5 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-sub {
    color: var(--fg-muted);
    max-width: 640px;
    margin: 0;
    font-size: 17px;
  }
</style>
