---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Pratham Goyal">
  <section style="text-align: center; padding: 60px 20px;">
    <div class="mono" style="color: var(--fg-dim); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;">Error 404</div>
    <h1 style="font-size: clamp(56px, 10vw, 140px); margin: 12px 0 8px; letter-spacing: -0.03em;">404.</h1>
    <p class="muted" style="max-width: 480px; margin: 0 auto 26px;">
      This page doesn't exist. It may have moved or never was.
    </p>
    <a class="btn primary" href="/">Take me home →</a>
  </section>
</Base>
